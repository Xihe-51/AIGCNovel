{
  "name": "front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:player": "vite build --config vite.player.config.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "size": "node scripts/survey-size.mjs",
    "verify": "run-p type-check test:run"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.3",
    "jwt-decode": "^4.0.0",
    "qrcode": "^1.5.4",
    "sass": "^1.89.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.18.5",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitest/coverage-v8": "^0.34.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "jsdom": "^22.1.0",
    "npm-run-all2": "^6.1.1",
    "typescript": "~5.2.0",
    "vite": "^4.4.11",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.19"
  }
}
