# ==================== AIGCNovel 环境配置模板 ====================
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略。

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=aigc

# ---------- 后端服务 ----------
SECRET_KEY=请改成随机字符串
DEBUG=true
HOST=127.0.0.1
PORT=8088

# ---------- Redis（缓存 + Celery broker） ----------
# 推荐用 Docker 起专用实例：docker run -d --name aigc-redis -p 6380:6379 --restart unless-stopped redis:7-alpine
# 没装 Redis 时保持 CACHE_ENABLED=false / ASYNC_ENABLED=false，系统自动降级
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_ENABLED=false
CACHE_TTL=60

# ---------- Celery 异步任务 ----------
ASYNC_ENABLED=false
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2

# ---------- AI 后端开关 ----------
# 文本：ollama（本地，计划书方案） | deepseek（云）
TEXT_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180

# ---------- 第 2 批：LangChain 上下文管理 ----------
MEMORY_ENABLED=true
MEMORY_MAX_TOKENS=1200
MEMORY_TTL=86400

# ---------- 第 2 批：RAG 角色人设库 ----------
RAG_ENABLED=true
RAG_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=3
RAG_INDEX_DIR=

# 图像：tongyi（云） | local（本地 SD，第 3 批）
IMAGE_BACKEND=tongyi
# 语音：volcengine（云 TTS） | musicgen（本地，第 3 批）
MUSIC_BACKEND=volcengine

# ---------- 第 3 批：本地 Stable Diffusion（CPU 模式） ----------
# 默认关闭：只有 IMAGE_BACKEND=local 或请求里传 model_id=local 才加载模型
SD_MODEL_PATH=
SD_LORA_PATH=
SD_CONFIG_DIR=
SD_DTYPE=bf16
SD_STEPS=6
SD_GUIDANCE=1.5
SD_MAX_PIXELS=262144
SD_MAX_SIZE=768
SD_MIN_FREE_RAM_GB=4.5
SD_UNLOAD_AFTER=true
SD_TIMEOUT=900

# ---------- 第 3 批：本地 MusicGen（CPU 音乐生成） ----------
# 只有 MUSIC_BACKEND=musicgen 或请求里 music 走 local 时才加载模型
MUSIC_MODEL_DIR=
MUSIC_DTYPE=bf16
MUSIC_DEFAULT_SECONDS=10
MUSIC_MAX_SECONDS=30
MUSIC_GUIDANCE=3.0
MUSIC_TEMPERATURE=1.0
# 可用内存低于此值拒绝加载；实测 bf16 加载后 RSS 约 1.4GB、峰值 1.7GB
MUSIC_MIN_FREE_RAM_GB=2.5
MUSIC_UNLOAD_AFTER=true

# 火山语音合成：TTS 用 appid + access_token，与 AK/SK 不是一套
VOLCENGINE_APPID=
VOLCENGINE_TTS_TOKEN=
VOLCENGINE_VOICE_TYPE=BV001_streaming
VOLCENGINE_CLUSTER=volcano_tts

# ---------- 云端 API 密钥（留空则不启用对应云后端） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TONGYI_API_KEY=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
